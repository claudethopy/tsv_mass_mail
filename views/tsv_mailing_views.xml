<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formularansicht -->
    <record id="view_tsv_mailing_form" model="ir.ui.view">
        <field name="name">tsv.mailing.form</field>
        <field name="model">tsv.mailing</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_add_all_members" type="object"
                            string="Alle aktiven Mitglieder hinzufügen"
                            invisible="state != 'draft'"/>
                    <button name="action_start" type="object"
                            string="Versand starten"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object"
                            string="Abbrechen"
                            invisible="state not in ('ready', 'sending')"/>
                    <button name="action_reset_draft" type="object"
                            string="Zurück zu Entwurf"
                            invisible="state not in ('done', 'cancelled')"/>
                    <button name="action_save_as_template" type="object"
                            string="Als Vorlage speichern"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,ready,sending,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="z. B. Newsletter Mai 2026"/>
                            <field name="subject" placeholder="Betreff der E-Mail"/>
                            <field name="template_id"
                                   readonly="state != 'draft'"
                                   placeholder="Vorlage wählen …"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="filter_department_ids"
                                   widget="many2many_tags"
                                   readonly="state != 'draft'"
                                   placeholder="Leer = alle Abteilungen"
                                   groups="tsv_access_restrictions.group_tsv_admin"/>
                        </group>
                    </group>
                    <field name="body_html" style="min-height: 400px;"
                           readonly="state != 'draft'"/>
                    <field name="attachment_ids" widget="many2many_binary"
                           readonly="state != 'draft'"/>
                    <notebook>
                        <page string="Empfänger" name="recipients">
                            <field name="recipient_ids" readonly="state != 'draft'">
                                <list>
                                    <field name="name"/>
                                    <field name="department_id"/>
                                    <field name="email"/>
                                </list>
                            </field>
                        </page>
                        <page string="Versandprotokoll" name="log"
                              invisible="state == 'draft'">
                            <group>
                                <group string="Fortschritt">
                                    <field name="total_count"/>
                                    <field name="sent_count"/>
                                    <field name="pending_count"/>
                                    <field name="failed_count"/>
                                </group>
                            </group>
                            <field name="recipient_line_ids" readonly="1">
                                <list decoration-success="state == 'sent'"
                                      decoration-danger="state == 'failed'"
                                      decoration-muted="state == 'pending'">
                                    <field name="partner_id"/>
                                    <field name="email"/>
                                    <field name="state"/>
                                    <field name="sent_at"/>
                                    <field name="error_message" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Listenansicht -->
    <record id="view_tsv_mailing_list" model="ir.ui.view">
        <field name="name">tsv.mailing.list</field>
        <field name="model">tsv.mailing</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="subject"/>
                <field name="total_count" string="Empfänger"/>
                <field name="sent_count" string="Gesendet"/>
                <field name="failed_count" string="Fehlgeschlagen"/>
                <field name="state"/>
                <field name="create_date" string="Erstellt"/>
            </list>
        </field>
    </record>

    <!-- Aktion -->
    <record id="action_tsv_mailing" model="ir.actions.act_window">
        <field name="name">Sammel-E-Mails</field>
        <field name="res_model">tsv.mailing</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menü: Untermenü von TSV -->
    <menuitem id="menu_tsv_mailing"
              name="Sammel-E-Mails"
              parent="tsv_main.menu_root"
              action="action_tsv_mailing"
              sequence="30"
              groups="tsv_access_restrictions.group_tsv_department_admin"/>

</odoo>
