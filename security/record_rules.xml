<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Department Admin: sieht nur Mailings der eigenen Abteilung -->
        <record id="rule_tsv_mailing_dept_admin" model="ir.rule">
            <field name="name">TSV Mailing: Abteilungs-Admin sieht nur eigene Abteilung</field>
            <field name="model_id" ref="tsv_mass_mail.model_tsv_mailing"/>
            <field name="domain_force">[('department_id', '=', user.partner_id.department_id.id)]</field>
            <field name="groups" eval="[(4, ref('tsv_access_restrictions.group_tsv_department_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- TSV Admin: sieht alle Mailings -->
        <record id="rule_tsv_mailing_admin" model="ir.rule">
            <field name="name">TSV Mailing: Admin sieht alle</field>
            <field name="model_id" ref="tsv_mass_mail.model_tsv_mailing"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('tsv_access_restrictions.group_tsv_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
